SAMPLES = ["Diglossa_baritula_114568","Diglossa_baritula_77283"]

rule all:
    input:
        expand("results/filtered/{sample}.filtered.vcf.gz", sample=SAMPLES)


rule fastp:
    threads: 4
    conda:
        "envs/fastp.yaml"
    input:
        r1="data/{sample}_R1_001.fastq.gz",
        r2="data/{sample}_R2_001.fastq.gz"
    output:
        r1="results/clean/{sample}_R1_001.clean.fastq.gz",
        r2="results/clean/{sample}_R2_001.clean.fastq.gz"
    shell:
        """
        fastp \
        -i {input.r1} -I {input.r2} \
        -o {output.r1} -O {output.r2}
        """


rule index_ref:
    input:
        "resources/hemoglobin_references.fasta"
    output:
        "resources/hemoglobin_references.fasta.fai"
    conda:
        "envs/align.yaml"
    shell:
        """
        samtools faidx {input}
        """

rule bwa_index:
    input:
        "resources/hemoglobin_references.fasta"
    output:
        expand("resources/hemoglobin_references.fasta.{ext}", ext=["bwt", "sa", "pac", "ann", "amb"])
    conda:
        "envs/align.yaml"
    shell:
        """
        bwa index {input}
        """


rule align:
    threads: 4
    resources:
        runtime=240,
        mem_mb=8000
    input:
        r1="results/clean/{sample}_R1_001.clean.fastq.gz",
        r2="results/clean/{sample}_R2_001.clean.fastq.gz",
        ref="resources/hemoglobin_references.fasta",
    output:
        "results/aligned/{sample}.sam"
    conda:
        "envs/align.yaml"
    shell:
        """
        bwa mem -t 4 {input.ref} {input.r1} {input.r2} > {output}
        """


rule sort_bam:
    threads: 2
    resources:
        runtime=120,
        mem_mb=4000
    input:
        "results/aligned/{sample}.sam"
    output:
        bam="results/aligned/{sample}.sorted.bam"
    conda:
        "envs/align.yaml"
    shell:
        """
        samtools sort -o {output.bam} {input}
        """


rule index_bam:
    threads: 1
    resources:
        runtime=600,
        mem_mb=4000
    input:
        "results/aligned/{sample}.sorted.bam"
    output:
        "results/aligned/{sample}.sorted.bam.bai"
    conda:
        "envs/align.yaml"
    shell:
        """
        samtools index {input}
        """


rule call_variants:
    resources:
        runtime=1800,
        mem_mb=4000
    input:
        bam="results/aligned/{sample}.sorted.bam",
        bai="results/aligned/{sample}.sorted.bam.bai",
        ref="resources/hemoglobin_references.fasta",
        fai="resources/hemoglobin_references.fasta.fai"
    output:
        "results/vcfs/{sample}.vcf.gz"
    conda:
        "envs/bcftools.yaml"
    shell:
        """
        bcftools mpileup -f {input.ref} {input.bam} | \
        bcftools call -mv -Oz -o {output}
        """


rule filter_variants:
    resources:
        runtime=1800,
        mem_mb=4000
    input:
        "results/vcfs/{sample}.vcf.gz"
    output:
        "results/filtered/{sample}.filtered.vcf.gz"
    conda:
        "envs/vcftools.yaml"
    shell:
        """
        vcftools \
        --gzvcf {input} \
        --remove-indels \
        --minQ 40 \
        --mac 2 \
        --min-meanDP 10 \
        --recode \
        --recode-INFO-all \
        --out results/filtered/{wildcards.sample}.filtered

        bgzip -c results/filtered/{wildcards.sample}.filtered.recode.vcf > {output}
        """
